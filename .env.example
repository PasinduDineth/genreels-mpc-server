# Local MCP server
PORT=8787
LOG_LEVEL=info

# RunPod port-8000 proxy URL, without a trailing slash.
RUNPOD_BASE_URL=https://YOUR_POD_ID-8000.proxy.runpod.net

# Optional separate public URL for returned media links when RUNPOD_BASE_URL
# points to an internal address such as http://127.0.0.1:8000.
RUNPOD_PUBLIC_BASE_URL=

RUNPOD_REQUEST_TIMEOUT_MS=60000
MODE_SWITCH_TIMEOUT_MS=600000
MODE_POLL_INTERVAL_MS=2000
VIDEO_POLL_INTERVAL_MS=4000
VIDEO_POLL_TIMEOUT_MS=1200000
REMOTE_IMAGE_TIMEOUT_MS=30000
REMOTE_IMAGE_MAX_BYTES=20000000
